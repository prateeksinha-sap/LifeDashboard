# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# App configuration
DATABASE_URL=sqlite:///./dashboard.db
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
NEWS_TOPICS=India personal finance RBI tax stock market mutual funds gold real estate health insurance education
GOLD_PRICE_INR_PER_GRAM=9000
# Set to true only when you want dashboard calls to hit yfinance for gold.
LIVE_GOLD_PRICE=false

# Personal CFO assumptions. These are used by forecast, coach, and assistant.
# Set this in your private backend/.env; keep the example non-personal.
USER_MONTHLY_SALARY_INR=0
SALARY_GROWTH_PCT=5
SPEND_INFLATION_PCT=6
RETURN_CASH_PCT=3
RETURN_STOCKS_PCT=11
RETURN_MF_EQUITY_PCT=11
RETURN_MF_DEBT_PCT=6.5
RETURN_GOLD_PCT=6
RETURN_REAL_ESTATE_PCT=6
RETURN_FD_PCT=6.5
RETURN_EPF_PCT=8.15
RETURN_PPF_PCT=7.1
RETURN_NPS_PCT=9

# Local AI configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
ASSISTANT_PROVIDER=auto
ASSISTANT_LOCAL_MODEL=gemma4:latest
ASSISTANT_LLM_TIMEOUT_SECONDS=45
OPENAI_STATUS_TIMEOUT_SECONDS=8
AI_EXTRACTION_PROVIDER=auto
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
SECTOR_GUIDANCE_PROVIDER=auto
SECTOR_NEWS_CACHE_MINUTES=360
SECTOR_GUIDANCE_CACHE_MINUTES=360
# Optional premium mode. Leave blank unless you want cloud LLM answers.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Provider choices: auto, fast, openai, anthropic, local.
# auto uses OpenAI if configured and working, then Anthropic, then Ollama, then fast grounded mode.
# local forces Ollama and is private, but may be slow on smaller laptops.

# Background automation. Runs only when the app is open.
# Gmail auto-sync requires credentials.json + token.json and any configured AI extraction provider.
AUTO_SYNC_ENABLED=true
AUTOMATION_LOOP_MINUTES=30
GMAIL_AUTO_SYNC_MINUTES=240
INVESTMENT_REFRESH_HOURS=24
EQUITY_LOOKTHROUGH_SYNC_ENABLED=true
EQUITY_LOOKTHROUGH_REFRESH_HOURS=24
# File/attachment ingestion. High-confidence bank/stocks/CAS/health files are
# imported automatically; credit-card/loan/manual-balance statements are staged.
INGESTION_AUTO_SYNC_ENABLED=true
INGESTION_AUTO_SYNC_MINUTES=240
INGESTION_AUTO_IMPORT=true
INGESTION_GMAIL_LOOKBACK_DAYS=45
INGESTION_GMAIL_MAX_MESSAGES=80
# Leave blank to use ~/Documents/LifeDashboard/IngestionInbox
INGESTION_INBOX_DIR=
# Leave blank to let the app discover the current AMFI market-cap file.
AMFI_MARKET_CAP_URL=
AUTO_CAPTURE_MONTH_END_SNAPSHOT=true

# Portfolio Agent integration. Leave blank to use:
# ~/Downloads/The A Team/portfolio-agent/logs/reports
PORTFOLIO_AGENT_REPORT_DIR=

# CAS PDF password. CDSL e-CAS usually uses PAN uppercase; some CAS exports use PAN+DOB.
# If you set PAN+DOB, the importer will also try PAN-only when it detects a PAN prefix.
CAS_PASSWORD=YOUR_CAS_PASSWORD

# Manual asset balances, in INR unless otherwise noted.
GOLD_GRAMS=0
EPF_BALANCE=0
PPF_BALANCE=0
NPS_BALANCE=0
AXIS_BANK_BALANCE=0
