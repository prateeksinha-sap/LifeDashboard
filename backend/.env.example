# Copy this file to .env and fill in your values
# NEVER commit .env to git

# CAS PDF password — typically PAN (uppercase) + DOB (DDMMYYYY)
# Example format: ABCDE1234F01011990
CAS_PASSWORD=YOUR_PAN_UPPERCASE_DDMMYYYY

# Gold: physical grams held (update manually)
GOLD_GRAMS=0

# Manual asset balances (update as needed, in ₹)
EPF_BALANCE=0
PPF_BALANCE=0
NPS_BALANCE=0
AXIS_BANK_BALANCE=0
